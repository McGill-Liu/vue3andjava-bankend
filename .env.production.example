# Copy these values to the production secret store. Do not commit the filled file.
DB_HOST=mysql
DB_PORT=3306
DB_NAME=points_mall
DB_USERNAME=pointsmall_app
DB_PASSWORD=replace-with-a-long-random-password
REDIS_HOST=redis
REDIS_PORT=6379
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=notifications@example.com
MAIL_PASSWORD=replace-with-the-mail-app-password
UPLOAD_DIRECTORY=/var/lib/points-mall/uploads
# Generate at least 32 random bytes, then encode as base64 or hexadecimal.
JWT_SECRET=replace-with-a-long-random-jwt-secret
# Use only for the first startup of an empty production database, then remove these values.
BOOTSTRAP_SUPER_ADMIN_ENABLED=false
BOOTSTRAP_SUPER_ADMIN_NAME=
BOOTSTRAP_SUPER_ADMIN_EMAIL=
BOOTSTRAP_SUPER_ADMIN_PASSWORD=
# Keep this disabled until the mini-program AppID, AppSecret and HTTPS domain are configured.
WECHAT_OPEN_ID_LOGIN_ENABLED=false
WECHAT_APP_ID=
WECHAT_APP_SECRET=
